# Copier vers deploy/.env sur le serveur et renseigner. JAMAIS commité.
#
# Depuis la phase 5 (retrait du monolithe), IMAGE, APP_PORT, JWT_SECRET, DOMAIN
# et CERTBOT_EMAIL ne servent plus : ils peuvent être effacés du .env du serveur
# (cf. docs/bascule-recette.md).

# --- Base de données ---
# openssl rand -hex 16
POSTGRES_PASSWORD=

# --- API et Cloudflare Tunnel : les six variables sont obligatoires ---
# Le CI fournit API_IMAGE ; à renseigner ici pour un déploiement manuel.
API_IMAGE=
# openssl rand -hex 32 (32 caractères minimum)
API_JWT_SECRET=
# Jeton du tunnel Cloudflare (Zero Trust → Networks → Tunnels), nom d'hôte
# public api.<domaine> → http://api:4000.
TUNNEL_TOKEN=
# Origines des deux PWA, sans chemin.
ORIGINE_WWW=https://www.morpion.cloud
ORIGINE_BACKOFFICE=https://backoffice.morpion.cloud

# --- Sauvegardes restic vers Cloudflare R2 ---
RESTIC_REPOSITORY=s3:https://<account_id>.r2.cloudflarestorage.com/<bucket>
# ATTENTION : clé de chiffrement du dépôt. En conserver une copie HORS
# du serveur (gestionnaire de mots de passe). Perdue = sauvegardes
# définitivement irrécupérables.
RESTIC_PASSWORD=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- Optionnel mais conseillé : alertes ---
# Sauvegarde qui n'a pas eu lieu (healthchecks.io ou équivalent)
BACKUP_PING_URL=
# Supervision qui renonce à redémarrer l'API (intervention requise)
HEALTH_PING_URL=

# --- Optionnel : uniquement si le paquet GHCR est privé ---
GHCR_USER=
GHCR_TOKEN=
