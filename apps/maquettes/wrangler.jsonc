{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  // Maquettes du design system, à valider sur tablette : pas de production.
  "name": "mb-maquettes",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "workers_dev": false,
  "preview_urls": false,
  "env": {
    "recette": {
      "name": "mb-maquettes-recette",
      "routes": [{ "pattern": "maquettes.morpion.cloud", "custom_domain": true }]
    }
  }
}
