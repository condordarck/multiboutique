# Configuration de l'API en développement local (npm run dev).
# `npm run dev` crée apps/api/.env à partir de ce fichier s'il n'existe pas,
# avec un API_JWT_SECRET aléatoire. Jamais commité.

# Base de docker-compose.yml (npm run db:dev).
DATABASE_URL=postgres://mb:dev@127.0.0.1:55433/multiboutique

# 32 caractères minimum : openssl rand -hex 32
API_JWT_SECRET=

# Origines des fronts de développement. http://localhost n'est accepté
# qu'hors production (NODE_ENV=production le refuse).
ORIGINE_WWW=http://localhost:5175
ORIGINE_BACKOFFICE=http://localhost:5174

# Images des produits, relatif à apps/api (donnees/ à la racine, ignoré par git).
UPLOADS_DIR=../../donnees/uploads

PORT=4000
