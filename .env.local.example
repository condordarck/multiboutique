# Fichier d'exemple de variables d'environnement.
# Copie-le vers `.env.local` si tu développes depuis l'hôte (npm run dev).
#
# DATABASE_URL : en production, défini dans docker-compose.yml (hostname `db`).
# Depuis l'hôte, la base est accessible via localhost:
DATABASE_URL=postgresql://mb:mbpassword@localhost:5432/multiboutique
#
# JWT_SECRET : doit être IDENTIQUE à la valeur utilisée au build de l'image.
# Si tu changes ce secret en production, reconstruis l'image (voir README).
JWT_SECRET=change-me-super-secret-please