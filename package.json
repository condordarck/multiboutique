{
  "name": "multiboutique",
  "version": "3.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:api": "node scripts/dev.mjs api",
    "dev:backoffice": "node scripts/dev.mjs backoffice",
    "dev:www": "node scripts/dev.mjs www",
    "db:dev": "docker compose up -d --wait db && CONTAINER=multiboutique-dev-db bash apps/api/db/migrate.sh",
    "test": "npm run test --workspaces --if-present",
    "build:workspaces": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "devDependencies": {
    "typescript": "^5.7.0",
    "wrangler": "4.151.1"
  }
}
